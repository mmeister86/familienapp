# Self-hosted Convex backend (dev). Copy to .env.local and fill in the real admin key.
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=your-admin-key-here

# Browser-facing Convex deployment URL.
# Dev is optional: `npx convex dev` writes the local value into .env.local itself.
# Prod is required at build time: it is baked into the bundle via the
# `VITE_CONVEX_URL` Docker build arg (see README › Deploy).
# Leave commented out here: an empty value would shadow the one Convex writes
# into .env.local.
# VITE_CONVEX_URL=

# Calendar device token (Convex calendar pilot, Task 4).
# Read-only Bearer secret for GET /dashboard/calendars only: it authorizes
# no ingest route, and neither INGEST_TOKEN nor DASHBOARD_TOKEN authorizes
# the calendar feed. The Go dashboard keeps it server-side as
# FAMILY_APP_CALENDAR_TOKEN. Never expose it to browsers.
CALENDAR_DASHBOARD_TOKEN=your-calendar-dashboard-token-here
